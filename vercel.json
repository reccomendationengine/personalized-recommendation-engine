{
  "version": 2,
  "builds": [
    {
      "src": "public/**",
      "use": "@vercel/static"
    },
    {
      "src": "index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "personal-recommendation-engine-firebase-adminsdk.json",
          "musicrec.js",
          "movierec.js"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*\\.html)$",
      "dest": "/public/$1"
    },
    {
      "src": "/(.*\\.js)$",
      "dest": "/public/$1"
    },
    {
      "src": "/(.*\\.css)$",
      "dest": "/public/$1"
    },
    {
      "src": "/(.*\\.png)$",
      "dest": "/public/$1"
    },
    {
      "src": "/(.*\\.jpg)$",
      "dest": "/public/$1"
    },
    {
      "src": "/(.*\\.ico)$",
      "dest": "/public/$1"
    },
    {
      "src": "/api/(.*)",
      "dest": "index.js"
    },
    {
      "src": "/health",
      "dest": "index.js"
    },
    {
      "src": "/(.*)",
      "dest": "index.js"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
